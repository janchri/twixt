/* One MCU alone on the bus: requests to itself, raw transfers to its own target
 * (the native_sim port can address it) and NACKs from an empty address.
 */

/ {
	chosen {
		twixt,self = &mcu_self;
	};
};

&i2c0 {
	compatible = "twixt,i2c-mm-native";
	bus-id = <42>;
	loopback;

	mcu_self: mcu@20 {
		compatible = "twixt,mcu";
		reg = <0x20>;
	};
};
