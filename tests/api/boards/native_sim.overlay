/* One MCU alone on the bus: requests to itself, raw transfers to its own target
 * (the native_sim port can address it), and NACKs from an empty address. A bus-id
 * of its own, so that the samples (bus 0 and 1) do not get in the way.
 */

/ {
	chosen {
		twixt,self = &mcu_self;
	};
};

&i2c0 {
	compatible = "twixt,native-i2c-mm";
	bus-id = <42>;
	loopback;

	mcu_self: mcu@20 {
		compatible = "twixt,mcu";
		reg = <0x20>;
	};
};
