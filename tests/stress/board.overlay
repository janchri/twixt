/* A board: its shell on a UART over the bus to the gateway */

/ {
	chosen {
		zephyr,shell-uart = &bus_uart;
	};

	bus_uart: bus-uart {
		compatible = "twixt,uart";
		peer = <&mcu_gw>;
	};
};
