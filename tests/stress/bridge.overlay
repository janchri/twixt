/* The bridge: per board a UART over the bus, bridged to a port to the host, host_<board>; its
 * own shell on host_pico. The board's overlay (boards/) has the ports, disabled: PTYs on native_sim,
 * USB CDC-ACM on the Raspberry Pi Pico.
 */

/ {
	chosen {
		zephyr,shell-uart = &host_pico;
	};

	bus_uart_nrf2: bus-uart-nrf2 {
		compatible = "twixt,uart";
		peer = <&mcu_nrf2>;
	};

	bridge-a {
		compatible = "zephyr,uart-bridge";
		peers = <&bus_uart_nrf2 &host_nrf2>;
	};

	bus_uart_nrf: bus-uart-nrf {
		compatible = "twixt,uart";
		peer = <&mcu_nrf>;
	};

	bridge-b {
		compatible = "zephyr,uart-bridge";
		peers = <&bus_uart_nrf &host_nrf>;
	};
};

&host_nrf2 {
	status = "okay";
};

&host_nrf {
	status = "okay";
};

&host_pico {
	status = "okay";
};
