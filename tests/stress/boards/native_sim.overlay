/* The bus on native_sim (twixt,native-i2c-mm); TWIXT_SELF_LABEL is mcu_<MCU>. The gateway's
 * ports to the host are PTYs (gateway.overlay enables them):
 * "pty-a connected to pseudotty: /dev/pts/N"
 */

/ {
	chosen {
		twixt,self = &TWIXT_SELF_LABEL;
	};

	host_a: pty-a {
		compatible = "zephyr,native-pty-uart";
		current-speed = <0>;
		status = "disabled";
	};

	host_b: pty-b {
		compatible = "zephyr,native-pty-uart";
		current-speed = <0>;
		status = "disabled";
	};

	host_gw: pty-gw {
		compatible = "zephyr,native-pty-uart";
		current-speed = <0>;
		status = "disabled";
	};
};

&i2c0 {
	compatible = "twixt,native-i2c-mm";
	bus-id = <4>;

	/* The MCUs are processes that the host scheduler wakes up within about a
	 * millisecond of each other: that is what counts as "at the same moment"
	 */
	start-window-us = <2000>;

#include "../twixt_mcus.dtsi"
};
