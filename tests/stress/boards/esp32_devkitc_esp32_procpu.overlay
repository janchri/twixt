#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	chosen {
		twixt,self = &mcu_esp;
	};

	i2c-mm {
		compatible = "twixt,i2c-mm-gpio";
		target = <&i2c0>;
		scl-gpios = <&gpio0 22 0>;
		sda-gpios = <&gpio0 21 0>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
#include "../twixt_mcus.dtsi"
	};
};

&i2c0 {
	compatible = "twixt,esp32-i2c-target";
	status = "okay";
	port = <0>;
	scl-gpios = <&gpio0 22 0>;
	sda-gpios = <&gpio0 21 0>;
};

/* Same priority as the target I2C ISR, on the sole enabled core. */
&gpio0 {
	interrupts = <GPIO_INTR_SOURCE 3 0>;
};
