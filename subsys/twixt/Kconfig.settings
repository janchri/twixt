menuconfig TWIXT_SETTINGS
	bool "Settings service"
	depends on SETTINGS
	select SETTINGS_RUNTIME
	help
	  See <twixt/settings.h>.

if TWIXT_SETTINGS

config TWIXT_SETTINGS_KEY_MAX
	int "Longest key, NUL included"
	default 24
	range 2 128

config TWIXT_SETTINGS_VALUE_MAX
	int "Longest value"
	default 16
	range 1 251
	help
	  Op, key and value of a set must fit TWIXT_REQ_DATA_MAX.

endif # TWIXT_SETTINGS
