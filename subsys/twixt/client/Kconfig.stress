menuconfig TWIXT_STRESS
	bool "Echo load"
	depends on TWIXT_ECHO
	help
	  A thread sends echo requests round-robin, with every length up to the
	  limit, and checks every answer byte. See <twixt/client/stress.h>. With
	  CONFIG_TWIXT_SHELL also "twixt stress".

if TWIXT_STRESS

config TWIXT_STRESS_STACK_SIZE
	int "Stack of the load thread"
	default 1024

endif # TWIXT_STRESS
