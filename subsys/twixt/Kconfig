DT_CHOSEN_TWIXT_SELF := twixt,self

menuconfig TWIXT
	bool "twixt: services between equal MCUs on a multi-master I2C bus"
	default y if $(dt_chosen_enabled,$(DT_CHOSEN_TWIXT_SELF))
	depends on I2C
	select I2C_MM
	help
	  On with /chosen twixt,self. See <twixt/twixt.h>.

if TWIXT

config TWIXT_INIT_PRIORITY
	int "Init priority"
	default 60
	help
	  After the I2C driver.

config TWIXT_SHELL
	bool "Shell commands"
	default y
	depends on SHELL

config TWIXT_PING
	bool "Ping service"
	default y
	help
	  Every MCU should answer it. See <twixt/ping.h>.

config TWIXT_ECHO
	bool "Echo service"
	default y
	help
	  Answers with the request data, for tests of the bus. See
	  <twixt/echo.h>.

config TWIXT_STRESS
	bool "Load command"
	depends on TWIXT_SHELL
	depends on TWIXT_ECHO
	help
	  "twixt stress start <interval_ms> <seconds> <addr>..." sends echo
	  requests round-robin from a thread for <seconds> (0: until
	  "twixt stress stop"), with every length up to the limit, and checks
	  every answer byte. "twixt stress" prints the counts. The MCUs at
	  <addr> need CONFIG_TWIXT_ECHO.

config TWIXT_STRESS_STACK_SIZE
	int "Stack of the load thread"
	default 1024
	depends on TWIXT_STRESS

rsource "Kconfig.settings"

module = TWIXT
module-str = twixt
source "subsys/logging/Kconfig.template.log_config"

endif # TWIXT
