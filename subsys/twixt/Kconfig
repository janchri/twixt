DT_CHOSEN_TWIXT_SELF := twixt,self

menuconfig TWIXT
	bool "twixt: services between equal MCUs on a multi-master I2C bus"
	default y if $(dt_chosen_enabled,$(DT_CHOSEN_TWIXT_SELF))
	depends on I2C
	select I2C_MM
	help
	  On with /chosen twixt,self. See <twixt/twixt.h>.

if TWIXT

config TWIXT_INIT_PRIORITY
	int "Init priority"
	default 60
	help
	  After the I2C driver.

config TWIXT_SHELL
	bool "Shell commands"
	default y
	depends on SHELL

config TWIXT_PING
	bool "Ping service"
	default y
	help
	  Every MCU should answer it. See <twixt/ping.h>.

config TWIXT_ECHO
	bool "Echo service"
	default y
	help
	  Answers with the request data, for tests of the bus. See
	  <twixt/echo.h>.

config TWIXT_STRESS
	bool "Echo load"
	depends on TWIXT_ECHO
	help
	  A thread sends echo requests round-robin, with every length up to
	  the limit, and checks every answer byte. See <twixt/stress.h>. With
	  CONFIG_TWIXT_SHELL also "twixt stress start <interval_ms> <seconds>
	  <addr>..." (0 s: until "twixt stress stop"), and "twixt stress" for
	  the counts. The targets need CONFIG_TWIXT_ECHO.

config TWIXT_STRESS_STACK_SIZE
	int "Stack of the load thread"
	default 1024
	depends on TWIXT_STRESS

config TWIXT_SMP
	bool "MCUmgr service"
	depends on MCUMGR
	select CRC if TWIXT_SMP_CRC
	help
	  MCUmgr (SMP) over the bus: this MCU's MCUmgr answers requests from
	  the others, and twixt_smp_send() sends packets to them. See
	  <twixt/smp.h>.

if TWIXT_SMP

config TWIXT_SMP_CRC
	bool "CRC-16 over each packet"
	default y
	help
	  The same on every MCU of the bus. A packet with a wrong CRC is
	  dropped; the sender of a request then times out.

config TWIXT_SMP_PEERS
	int "Packets coming in at the same time"
	default 4
	help
	  One per MCU sending to this one at once.

endif # TWIXT_SMP

rsource "Kconfig.settings"

module = TWIXT
module-str = twixt
source "subsys/logging/Kconfig.template.log_config"

endif # TWIXT
