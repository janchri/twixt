menuconfig TWIXT_LINK
	bool "Multi-master I2C link: one request/response transfer each"
	select I2C_TARGET
	help
	  See <twixt/link.h>.

if TWIXT_LINK

config TWIXT_LINK_MSG_MAX
	int "Longest request or response"
	default 64
	range 8 255
	help
	  In bytes. The same on every MCU of the bus.

config TWIXT_LINK_RETRY_MS
	int "Retry time after lost arbitration or a busy bus, in ms"
	default 500

config TWIXT_LINK_NACK_RETRY_MS
	int "Retry time after an address NACK, in ms"
	default 5
	help
	  An MCU sending itself may NACK its address until it is a target again.
	  After this long the target counts as absent (-ENXIO). Other NACKs are
	  not retried: the request may have run.

module = TWIXT_LINK
module-str = twixt_link
source "subsys/logging/Kconfig.template.log_config"

endif # TWIXT_LINK

DT_CHOSEN_TWIXT_SELF := twixt,self

menuconfig TWIXT
	bool "twixt: services between equal MCUs on a multi-master I2C bus"
	default y if $(dt_chosen_enabled,$(DT_CHOSEN_TWIXT_SELF))
	depends on I2C
	select TWIXT_LINK
	help
	  On with /chosen twixt,self. See <twixt/twixt.h>.

if TWIXT

config TWIXT_INIT_PRIORITY
	int "Init priority"
	default 60
	help
	  After the I2C driver.

config TWIXT_SHELL
	bool "Shell commands"
	default y
	depends on SHELL

rsource "service/Kconfig.ping"
rsource "service/Kconfig.echo"
rsource "service/Kconfig.settings"
rsource "service/Kconfig.smp"
rsource "client/Kconfig.stress"
rsource "client/Kconfig.smp_gateway"

module = TWIXT
module-str = twixt
source "subsys/logging/Kconfig.template.log_config"

endif # TWIXT
