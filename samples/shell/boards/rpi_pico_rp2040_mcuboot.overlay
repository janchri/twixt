/* The bridge. The bus on GP4 (pin 6), GP5 (pin 7), at 3.3 V: I2C0 is the target, the controller
 * software on the same pins (twixt,i2c-mm-gpio). pinctrl-0 gives the pins back to I2C0.
 */

#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	chosen {
		twixt,self = &mcu_pico;
		zephyr,console = &usb_log;
		zephyr,shell-uart = &host_pico;
		zephyr,uart-mcumgr = &usb_mcumgr;
	};

	i2c-mm {
		compatible = "twixt,i2c-mm-gpio";
		target = <&i2c0>;
		scl-gpios = <&gpio0 5 0>;
		sda-gpios = <&gpio0 4 0>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		pinctrl-0 = <&i2c0_default>;
		pinctrl-names = "default";
		#address-cells = <1>;
		#size-cells = <0>;

#include "../twixt_mcus.dtsi"
	};
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_P4>, <I2C0_SCL_P5>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up; /* weak; the bus needs its own pull-ups */
		};
	};
};

/* The bridge's ports to the laptop (bridge.overlay enables them) */
&zephyr_udc0 {
	/* The same order on every twixt Pico: if00 the log, if02 MCUmgr, if04 the bridge's shell,
	 * then the boards. Only MCUmgr waits for the host (hw-flow-control): it writes its answers
	 * with poll_out, which drops what does not fit otherwise.
	 */
	usb_log: usb-log {
		compatible = "zephyr,cdc-acm-uart";
		label = "twixt log";
	};

	usb_mcumgr: usb-mcumgr {
		compatible = "zephyr,cdc-acm-uart";
		label = "twixt mcumgr";
		hw-flow-control;
	};

	host_pico: host-pico {
		compatible = "zephyr,cdc-acm-uart";
		label = "twixt bridge";
		status = "okay";
	};

	host_nrf2: host-nrf2 {
		compatible = "zephyr,cdc-acm-uart";
		label = "twixt board nrf2";
		status = "disabled";
	};

	host_nrf: host-nrf {
		compatible = "zephyr,cdc-acm-uart";
		label = "twixt board nrf";
		status = "disabled";
	};

	host_nrf3: host-nrf3 {
		compatible = "zephyr,cdc-acm-uart";
		label = "twixt board nrf3";
		status = "disabled";
	};

};
