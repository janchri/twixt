/* The gateway: a UART to the board, bridged to a PTY */

/ {
	bus_uart_a: bus-uart-a {
		compatible = "twixt,uart";
		peer = <&mcu_a>;
	};

	bridge-a {
		compatible = "zephyr,uart-bridge";
		peers = <&bus_uart_a &host_a>;
	};
};

&host_a {
	status = "okay";
};
